# Copy to .env for local development outside Docker.
DATABASE_URL=postgresql+asyncpg://taskforge:taskforge@localhost:5432/taskforge
SECRET_KEY=change-me-to-something-long-and-random
ENV=dev

# Optional — enables the llm_* job types and automatic AI triage of dead-lettered jobs.
# Everything else works without it.
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5
# AI_TRIAGE_ENABLED=true
